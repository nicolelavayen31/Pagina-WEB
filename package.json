{
  "name": "mantenimientos-integrales-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --dir apps/api prisma generate",
    "db:migrate": "pnpm --dir apps/api prisma migrate dev",
    "db:seed": "pnpm --dir apps/api prisma db seed"
  }
}
