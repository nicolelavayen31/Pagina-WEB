{
  "name": "mantenimientos-integrales-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "predev": "pnpm --filter @repo/contracts build",
    "dev": "pnpm -r --parallel --filter !@repo/contracts dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @repo/contracts build && pnpm -r test",
    "test:int": "pnpm --filter @repo/contracts build && pnpm --filter api test:int",
    "test:e2e": "pnpm --filter web test:e2e",
    "typecheck": "pnpm --filter @repo/contracts build && pnpm -r typecheck",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:deploy": "pnpm --filter api exec prisma migrate deploy",
    "db:status": "pnpm --filter api exec prisma migrate status",
    "db:seed": "pnpm --filter api exec prisma db seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "sharp"
    ]
  }
}
