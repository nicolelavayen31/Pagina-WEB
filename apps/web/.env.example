# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets here.

# Where the Next.js server reaches the API (server-side fetches and the /api/* rewrite).
API_INTERNAL_URL="http://127.0.0.1:3001"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
