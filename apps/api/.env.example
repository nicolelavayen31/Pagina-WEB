# Copy to apps/api/.env and fill in. Validated at startup (packages/contracts envSchema):
# the API refuses to boot with missing or invalid values.

NODE_ENV=development
PORT=3001

# Use a dedicated database user with the minimum privileges, not the "postgres" superuser.
DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/mantenimiento_db?schema=public"

# Session lifetime in milliseconds (default 8 h). Sessions are stored hashed in the database.
SESSION_TTL_MS=28800000

# Comma-separated list of allowed browser origins (the web app). Used for CORS and the CSRF Origin check.
CORS_ORIGIN="http://localhost:3000"

# Number of reverse proxies in front of the API (Next.js rewrite = 1). Needed for real client IPs in rate limiting.
TRUST_PROXY=1

# Cloudflare Turnstile secret. Optional in development, REQUIRED in production.
TURNSTILE_SECRET_KEY=""

# Image storage. Only "local" is implemented; UPLOAD_DIR must be private (not served statically) and backed up.
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES=10485760

# Requests per minute per IP.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LEADS=3

# First administrator, used only by `pnpm db:seed` when the account does not exist yet.
# Remove ADMIN_PASSWORD from this file after the first seed.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# New quote request e-mail through Resend (https://resend.com, free tier). Leave RESEND_API_KEY empty to disable.
# LEAD_NOTIFY_FROM must use a domain verified in Resend. LEAD_NOTIFY_TO accepts several addresses separated by commas.
RESEND_API_KEY=""
LEAD_NOTIFY_TO=""
LEAD_NOTIFY_FROM="Sitio web <avisos@su-dominio.com>"
