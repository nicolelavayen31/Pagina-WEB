# Copy to deploy/.env.production on the server and fill in. NEVER commit the real file.
# Generate each password with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Domain without https:// or www (e.g. miempresa.com). Its DNS A record must point to the server IP.
SITE_DOMAIN=

# Database
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile -> Add site). Both are required.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# New quote request e-mail (resend.com). Optional: leave RESEND_API_KEY empty to disable.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Public contact details (empty = hidden). WhatsApp in international format without "+": 593979584079
WHATSAPP_NUMBER=593979584079
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=
CONTACT_HOURS=

# First administrator, only for the first seed. DELETE ADMIN_PASSWORD after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
